# Copy to .env and change all values marked CHANGE_ME.
# .env is ignored by git and must never contain real patient data.

# PostgreSQL (docker compose)
POSTGRES_DB=patientcard
POSTGRES_USER=patientcard
POSTGRES_PASSWORD=CHANGE_ME_strong_database_password

# Backend datasource (matches docker compose defaults)
DB_URL=jdbc:postgresql://localhost:5432/patientcard
DB_USERNAME=patientcard
DB_PASSWORD=CHANGE_ME_strong_database_password

# JWT: at least 32 bytes. Generate e.g. with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_at_least_32_bytes_long_random_secret
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D

# Local file storage (relative to the process working directory)
STORAGE_ROOT=../storage
MAX_FILE_SIZE_BYTES=26214400
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=30MB

# HTTP
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=

# AI (ETAP 1 always uses mock; LM Studio variables prepare ETAP 4)
AI_PROVIDER=mock
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model
LM_STUDIO_MODEL_VERSION=
AI_CONNECT_TIMEOUT=PT10S
AI_REQUEST_TIMEOUT=PT2M
AI_MAX_CONTEXT_CHARS=8000
AI_MAX_CONTEXT_ITEMS=10
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=800
